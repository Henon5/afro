PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Connection String
# For local development with MongoDB installed locally:
# MONGODB_URI=mongodb://localhost:27017/afro-bingo?retryWrites=true&w=majority
# For MongoDB Atlas (replace <db_password> with your actual password):
# IMPORTANT: Replace <db_password> with your actual MongoDB Atlas password
# Example: mongodb+srv://henokkifle_db_user:MySecurePass123@cluster0.enemcot.mongodb.net/afro-bingo?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://henokkifle_db_user:<db_password>@cluster0.enemcot.mongodb.net/afro-bingo?retryWrites=true&w=majority

# Telegram Bot Token (Get from @BotFather on Telegram)
# SECURITY: Replace with your actual bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# JWT Secret - MUST generate a strong random string for production (min 64 chars)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=afro-bingo-jwt-secret-key-change-in-production-12345678
JWT_EXPIRE=7d

# Admin Security - MUST change these in production to strong values
ADMIN_MASTER_ID=MasterAdmin
ADMIN_SECURE_CODE=SECURE123
ADMIN_SECURITY_KEY=GOLDENKEY

# Additional admin token header - MUST change in production
ADMIN_SECRET_KEY=ADMIN_SECRET_TOKEN_CHANGE_IN_PRODUCTION

# Add your Telegram User ID here to grant admin access (comma-separated for multiple admins)
ADMIN_IDS=69ee67ef3d4dd5e9703f0599,685983288

HOUSE_COMMISSION=0.15
MIN_DEPOSIT=20
MIN_WITHDRAWAL=10
MAX_WITHDRAWAL=5000

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
